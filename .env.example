# Required to use POST /api/set-all. Generate a long random value for production.
APP_ADMIN_CODE=replace-with-a-long-random-secret
ADMIN_COOKIE_SECURE=false

# Redis defaults are suitable for docker compose. Use localhost when running the API locally.
REDIS_KV_SIMPLE_CACHE_HOST=redis
REDIS_KV_SIMPLE_CACHE_PORT=6379
REDIS_KV_SIMPLE_CACHE_DB=0

# Optional: signed Codeforces API requests. Leave both blank for public contest data.
CODEFORCES_API_KEY=
CODEFORCES_API_SECRET=
CODEFORCES_CONTEST_ID=0
CODEFORCES_REFRESH_INTERVAL_SECONDS=15
STAFF_REQUEST_TIMEOUT_SECONDS=10

# Optional JSON list for separate frontend deployments, e.g. ["https://monitor.example.org"]
CORS_ORIGINS=[]
